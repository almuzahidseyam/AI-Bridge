{
  "manifest_version": 3,
  "name": "AI-Bridge: Context Transfer",
  "version": "6.0",
  "description": "Seamlessly transfer chat context between ChatGPT, Claude, Gemini, Perplexity, and HuggingFace. Features Smart Heuristics and Zip Progress.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://www.perplexity.ai/*",
    "*://huggingface.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI-Bridge Transfer"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://chatgpt.com/*", 
        "*://claude.ai/*", 
        "*://gemini.google.com/*",
        "*://www.perplexity.ai/*",
        "*://huggingface.co/chat/*"
      ],
      "js": ["content.js"]
    }
  ]
}
